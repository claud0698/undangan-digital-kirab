---
import { type Lang } from "~/i18n";
import { invitation } from "~/config/invitation";
interface Props { lang: Lang; }
const { lang } = Astro.props;

// Tiles are pre-rendered webp in /public/sponsors, exported at roughly 2x their
// largest rendered width. `rank` drives tile size only — 1 largest, 5 smallest.
// Keep `dims` in step with the exports (see .claude/skills/print-logo-to-web).
const dims = {
  1: { w: 960, h: 720 },   // 4:3 — square group lockups
  2: { w: 660, h: 440 },
  3: { w: 540, h: 360 },
  4: { w: 420, h: 280 },
  5: { w: 420, h: 280 },
} as const;

const ranks = [1, 2, 3, 4, 5] as const;

const roster = ranks
  .map((r) => ({ rank: r, items: invitation.sponsorLogos.filter((l) => l.rank === r) }))
  .filter((g) => g.items.length);
---
<section class="sponsors" data-reveal>
  <div class="eyebrow">{lang === "id" ? "Dukungan" : "Supported By"}</div>
  <h2 class="section-title">{lang === "id" ? "Para Donatur & Sponsor" : "Donors & Sponsors"}</h2>
  <div class="section-han">護 持 緣 主</div>
  <div class="section-han-roman">{lang === "id" ? "Penyangga Berkah" : "Pillars of Blessing"}</div>
  <div class="divider"><span class="line"></span><span class="dot"></span><span class="line"></span></div>

  <p class="lead">
    {lang === "id"
      ? "Terima kasih kepada para donatur & sponsor yang berkenan mendukung Kirab Budaya & Ruwat Bumi 2026."
      : "Our gratitude to the donors & sponsors who graciously support Kirab Budaya & Ruwat Bumi 2026."}
  </p>

  <div class="roster">
    {roster.map((g) => (
      <div class:list={["logo-grid", `rank-${g.rank}`]}>
        {g.items.map((l) => (
          <div class="logo-slot">
            <img
              src={`/sponsors/${l.slug}.webp`}
              alt={l.name}
              width={dims[g.rank].w}
              height={dims[g.rank].h}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </div>
        ))}
      </div>
    ))}

    {invitation.sponsorDonors.length ? (
      <ul class="donor-list" role="list">
        {invitation.sponsorDonors.map((d) => (
          <li>
            <span class="d-name">{d.name}</span>
            {d.note && <em class="d-note">“ {d.note} ”</em>}
          </li>
        ))}
      </ul>
    ) : null}
  </div>

  <p class="footnote">
    <em>
      {lang === "id" ? (
        <Fragment>
          Tertarik menjadi bagian dari acara ini?<br />
          Bagi Bapak/Ibu/Saudara/i, Umat, dan para Donatur yang ingin berpartisipasi, dana dapat disalurkan melalui:
        </Fragment>
      ) : (
        <Fragment>
          Interested in supporting this event?<br />
          Donors who wish to participate may channel their contributions through:
        </Fragment>
      )}
    </em>
  </p>

  <div class="donasi">
    <div class="bank-card">
      <span class="bank-label">{lang === "id" ? "Rekening Donasi" : "Donation Account"}</span>
      <span class="bank-name">Bank BCA</span>
      <span class="bank-no">10 888 666 72</span>
      <span class="bank-holder">a/n. Yayasan Wihara Dhamma Budhi Bhakti</span>
      <span class="bank-note">
        {lang === "id" ? (
          <Fragment>Mohon tambahkan <strong>72</strong> di akhir nominal transfer (cth: Rp&nbsp;500.072) — kode khusus dana Kirab.</Fragment>
        ) : (
          <Fragment>Please add <strong>72</strong> to the end of your transfer amount (e.g. Rp&nbsp;500,072) — the unique code for Kirab funds.</Fragment>
        )}
      </span>
    </div>

    <div class="contact-group">
      <span class="contact-heading">{lang === "id" ? "Informasi & Konfirmasi Dana" : "Donation Info & Confirmation"}</span>
      <ul class="contact-list" role="list">
        <li>
          <span class="c-name">Liliany Candra <em>· {lang === "id" ? "Wk. Bendahara" : "Vice Treasurer"}</em></span>
          <a href="https://wa.me/6281369757888" target="_blank" rel="noopener">+62 813-6975-7888</a>
        </li>
        <li>
          <span class="c-name">Bella Safira <em>· {lang === "id" ? "Dana & Sponsorship" : "Funds & Sponsorship"}</em></span>
          <a href="https://wa.me/6281288921023" target="_blank" rel="noopener">+62 812-8892-1023</a>
          <a class="c-email" href="mailto:bellassafiraa@gmail.com">bellassafiraa@gmail.com</a>
        </li>
      </ul>
    </div>

    <div class="contact-group">
      <span class="contact-heading">{lang === "id" ? "PIC Pengiriman Data / Gambar Sponsor" : "PIC for Sponsor Data / Artwork"}</span>
      <ul class="contact-list" role="list">
        <li>
          <span class="c-name">Lukas Susanto</span>
          <a href="https://wa.me/6285692413938" target="_blank" rel="noopener">+62 856 9241 3938</a>
          <a class="c-email" href="mailto:lian0901lucas@gmail.com">lian0901lucas@gmail.com</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="paramita">
    <div class="paramita-han">檀 波 羅 蜜</div>
    <div class="paramita-title">Dana Paramita</div>
    <p>
      {lang === "id"
        ? "Sekecil apapun dana, sumbangsih dan dukungan yang diberikan oleh para donatur akan sangat bermanfaat bagi kami semua di hari Sejit Tjie Thien Ta Sen Bio yang ke-43 tahun."
        : "No matter how small, every contribution and support given by our donors will be deeply meaningful for us all on the 43rd anniversary of Tjie Thien Ta Sen Bio."}
    </p>
    <p>
      {lang === "id"
        ? "Tujuan mulia ini akan terselenggara berkat kebajikan para donatur dan simpatisan."
        : "This noble purpose is made possible through the virtue of our donors and well-wishers."}
    </p>
    <blockquote>
      {lang === "id"
        ? "“ Partisipasi Bapak/Ibu/Sdr/i sangat berguna untuk melestarikan Budaya Tionghoa dan Tjie Thien Ta Sen Bio Tangerang ”"
        : "“ Your participation is invaluable in preserving Chinese culture and Tjie Thien Ta Sen Bio Tangerang ”"}
    </blockquote>
  </div>
</section>

<style>
  .sponsors {
    background: var(--paper-2);
    padding: 70px 30px;
  }
  .sponsors .eyebrow { color: var(--red); }

  .lead {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-style: italic;
    text-align: center;
    color: var(--ink);
    opacity: 0.85;
    max-width: 460px;
    margin: 0 auto 2.2rem;
    font-size: 16px;
    line-height: 1.6;
  }

  .roster {
    max-width: 460px;
    margin: 0 auto;
  }

  /* Flex rather than grid: a remainder row centres itself instead of leaving the
     last sponsor stranded at the left edge with empty space beside it. */
  .logo-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    --cols: 3;
  }
  .logo-grid + .logo-grid { margin-top: 16px; }

  .logo-slot {
    flex: 0 0 calc((100% - (var(--cols) - 1) * 10px) / var(--cols));
    aspect-ratio: 3 / 2;
    border: 1px solid var(--gold);
    background: #fff;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  @media (hover: hover) {
    .logo-slot:hover {
      border-color: var(--red);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(74, 8, 8, 0.18);
    }
  }
  .logo-slot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Size ladder — fewer columns means a bigger tile. Descends with contribution. */
  .rank-1 { --cols: 1; }
  .rank-2 { --cols: 2; }
  .rank-3 { --cols: 2; }
  .rank-4 { --cols: 3; }
  .rank-5 { --cols: 4; }
  .rank-1 .logo-slot { aspect-ratio: 4 / 3; }

  .donor-list {
    margin-top: 26px;
  }

  .donor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    text-align: center;
  }
  .donor-list li {
    border-top: 1px dashed rgba(122, 16, 16, 0.22);
    padding-top: 10px;
  }
  .donor-list .d-name {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
    color: var(--red-deep);
  }
  .donor-list .d-note {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 13px;
    /* --gold on --paper-2 is 2.36:1; this is real content (Chinese names, cities),
       not decoration, so it needs to clear AA. --red is 7.86:1. */
    color: var(--red);
    opacity: 0.85;
  }

  .donasi {
    max-width: 460px;
    margin: 1.6rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bank-card {
    background: var(--red-deep);
    border: 1px solid var(--gold);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }
  .bank-label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold-bright);
    margin-bottom: 4px;
  }
  .bank-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 22px;
    color: var(--paper);
    line-height: 1;
  }
  .bank-no {
    font-family: 'Cinzel', serif;
    font-size: 22px;
    letter-spacing: 0.12em;
    color: var(--gold-pale);
    margin: 2px 0;
  }
  .bank-holder {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--paper);
    opacity: 0.85;
    line-height: 1.4;
  }
  .bank-note {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed rgba(212, 175, 96, 0.4);
    font-family: 'Cormorant Garamond', serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--gold-pale);
  }
  .bank-note strong {
    color: var(--gold-bright);
    font-weight: 700;
    font-size: 1.15em;
    letter-spacing: 0.05em;
  }

  .contact-group {
    border-top: 1px dashed rgba(122, 16, 16, 0.3);
    padding-top: 16px;
    text-align: center;
  }
  .contact-heading {
    display: block;
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--red);
    opacity: 0.8;
    margin-bottom: 12px;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-list .c-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 17px;
    color: var(--red-deep);
  }
  .contact-list .c-name em {
    font-weight: 400;
    font-style: italic;
    font-size: 13px;
    color: var(--ink);
    opacity: 0.65;
  }
  .contact-list a {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    letter-spacing: 0.06em;
    /* was --gold: the same 2.36:1 as .d-note above, on the only conversion path
       in the section. --red is 7.86:1, and matches .c-email directly beneath. */
    color: var(--red);
    text-decoration: none;
    /* WCAG 2.5.8 wants a 24px target; 14px Cinzel alone gives ~21px. */
    display: inline-block;
    padding: 4px 0;
  }
  .contact-list a:hover { color: var(--red-bright); }
  .contact-list a.c-email {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 13px;
    letter-spacing: 0;
    color: var(--red);
    opacity: 0.85;
  }

  .paramita {
    max-width: 460px;
    margin: 2.6rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--gold);
    text-align: center;
  }
  .paramita-han {
    font-family: 'Noto Serif SC', serif;
    font-size: 16px;
    letter-spacing: 0.3em;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .paramita-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 28px;
    color: var(--red-deep);
    line-height: 1;
    margin-bottom: 1.2rem;
  }
  .paramita p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    opacity: 0.88;
    margin: 0 auto 1rem;
  }
  .paramita blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.6;
    color: var(--red);
    margin: 1.4rem 0 0;
    padding: 0;
  }

  .footnote {
    margin: 2.4rem auto 0;
    text-align: center;
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    color: var(--ink);
    opacity: 0.8;
    font-size: 14px;
    line-height: 1.6;
    max-width: 460px;
  }
  .footnote em { color: var(--red); }

  @media (min-width: 720px) {
    .roster { max-width: 640px; }
    .rank-1 { --cols: 2; }
    .rank-2 { --cols: 3; }
    .rank-3 { --cols: 4; }
    .rank-4 { --cols: 5; }
    .rank-5 { --cols: 6; }
    .donor-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1080px) {
    .roster { max-width: 860px; }
    .rank-1 { --cols: 2; }
    .rank-2 { --cols: 3; }
    .rank-3 { --cols: 4; }
    .rank-4 { --cols: 6; }
    .rank-5 { --cols: 7; }
    .donor-list { grid-template-columns: repeat(4, 1fr); }
  }
</style>
