---
import { type Lang } from "~/i18n";
import { invitation } from "~/config/invitation";
interface Props { lang: Lang; }
const { lang } = Astro.props;

// Order is the committee's own — never sort this. Re-ordering a merit roll to make
// it tidy would silently demote someone.
const donors = invitation.sponsorDonors;

// Stagger index is capped so the unveiling stays under ~0.6s however long the roll
// grows; past ~12 names the remainder arrive together rather than dripping in.
const STAGGER_CAP = 11;
---
{donors.length > 0 && (
  <section class="donatur" data-reveal>
    <div class="eyebrow">{lang === "id" ? "Terima Kasih" : "With Gratitude"}</div>
    <h2 class="section-title">{lang === "id" ? "Para Donatur" : "Our Donors"}</h2>
    <div class="section-han">功 德 芳 名</div>
    <div class="section-han-roman">{lang === "id" ? "Nama Para Dermawan" : "Roll of Merit"}</div>
    <div class="divider"><span class="line"></span><span class="dot"></span><span class="line"></span></div>

    <p class="lead">
      {lang === "id"
        ? "Dengan penuh hormat kami sampaikan terima kasih kepada Bapak/Ibu/Saudara/i sekeluarga yang telah berkenan berdana bagi terselenggaranya acara ini."
        : "With deep respect we thank the families whose generosity made this celebration possible."}
    </p>

    <ul class="donor-list" role="list">
      {donors.map((d, i) => (
        <li class="donor" style={`--i:${Math.min(i, STAGGER_CAP)}`}>
          <span class="d-name">{d.name}</span>
          {d.chineseName && <span class="d-chinese">{d.chineseName}</span>}
          {d.city && <span class="d-city">{d.city}</span>}
        </li>
      ))}
    </ul>

    <p class="roll-note">
      {lang === "id"
        ? "Nama disusun sesuai urutan penerimaan, tanpa maksud pemeringkatan."
        : "Names appear in the order received, with no ranking implied."}
    </p>
  </section>
)}

<style>
  .donatur {
    background: var(--paper);
    padding: 70px 30px;
  }
  .donatur .eyebrow { color: var(--red); }

  .lead {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-style: italic;
    text-align: center;
    color: var(--ink);
    opacity: 0.85;
    max-width: 460px;
    margin: 0 auto 2.4rem;
    font-size: 16px;
    line-height: 1.6;
  }

  /* auto-fit so one rule serves 8 names and 150 without a redesign */
  .donor-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 460px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    text-align: center;
  }
  .donor {
    border-top: 1px dashed rgba(122, 16, 16, 0.22);
    padding-top: 16px;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .d-name {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.25;
    /* Deliberately ink, not --red-deep: writing a living person's name in red is a
       long-standing taboo (丹書不祥). Temple boards put gold or black characters ON
       a red ground — the ground is red, the name is not. */
    color: var(--ink);
  }
  /* A generation name (Quency and Gloria share 芳/Fong), not an alias — so no
     quotation marks, which would read as "so-called". */
  .d-chinese {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--red);
    opacity: 0.9;
    margin-top: 3px;
  }
  .d-city {
    display: block;
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    /* --gold here is 2.75:1 on --paper, which fails AA at 9px. --red at .8 is 5.98:1. */
    color: var(--red);
    opacity: 0.8;
    margin-top: 6px;
  }

  .roll-note {
    max-width: 460px;
    margin: 2.4rem auto 0;
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--ink);
    opacity: 0.55;
  }

  /* The roll is unveiled, then the names breathe. Two rules govern this:
     nothing ever disappears, and nothing ever drops below AA. The floor is 0.62,
     measured: --ink at .62 over --paper is 5.13:1, where .55 would be 4.07:1 and
     fail. Only .d-name breathes — the Chinese name and city stay put, because
     compounding their own alpha with a fading parent would sink them below AA.
     Phase is staggered per item so the roll shimmers rather than pulsing in unison.
     Reduced motion is handled globally in global.css (animation: none !important). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.anim-ready) [data-reveal] .donor {
      opacity: 0;
      transform: translateY(8px);
    }
    :global(.anim-ready) [data-reveal].in-view .donor {
      opacity: 1;
      transform: none;
      transition: opacity 0.55s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(var(--i, 0) * 55ms);
    }
    :global(.anim-ready) [data-reveal].in-view .d-name {
      animation: donor-breath 9s ease-in-out infinite;
      /* starts after the unveiling has settled, then drifts out of phase */
      animation-delay: calc(1.4s + var(--i, 0) * 680ms);
    }
  }

  @keyframes donor-breath {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.62; }
  }

  @media (min-width: 720px) {
    .donor-list {
      max-width: 640px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .donor-list { max-width: 860px; }
  }
</style>
