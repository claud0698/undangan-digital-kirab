---
import { type Lang } from "~/i18n";
import { invitation } from "~/config/invitation";
import DonorName from "./DonorName.astro";
interface Props { lang: Lang; }
const { lang } = Astro.props;

// The config order is the ledger's and stays canonical: it is what the screen-reader
// and no-script list read. The visible roll shuffles it once per visit (see script),
// so no name is permanently first or last.
const donors = invitation.sponsorDonors;
const N = donors.length;

// Eight cells in a 2 x 4 grid. Every donor card is rendered once into a <template>;
// the script clones them into the cells and turns one line (two cells) at a time.
const CELLS = Math.min(N, 8);

// Initial for the seal, skipping honorifics and the family prefix so the letter
// belongs to the person rather than to "Bpk." or "Keluarga".
const SKIP = /^(bp|bpk|bapak|ibu|mr|mrs|ms|sdr|sdri|ko|alm|almh|kel|keluarga)\.?$/i;
const initial = (name: string) => {
  const word = name.split(/[\s/]+/).find((w) => /[A-Za-z]/.test(w) && !SKIP.test(w)) ?? name;
  return (word.match(/[A-Za-z]/)?.[0] ?? "·").toUpperCase();
};
---
{N > 0 && (
  <section class="donatur" data-reveal>
    <div class="eyebrow">{lang === "id" ? "Terima Kasih" : "With Gratitude"}</div>
    <h2 class="section-title">{lang === "id" ? "Para Donatur" : "Our Donors"}</h2>
    <div class="section-han">功 德 芳 名</div>
    <div class="section-han-roman">{lang === "id" ? "Nama Para Dermawan" : "Roll of Merit"}</div>
    <div class="divider"><span class="line"></span><span class="dot"></span><span class="line"></span></div>

    <p class="lead">
      {lang === "id"
        ? "Dengan penuh hormat kami sampaikan terima kasih kepada Bapak/Ibu/Saudara/i sekeluarga yang telah berkenan berdana bagi terselenggaranya acara ini."
        : "With deep respect we thank the families whose generosity made this celebration possible."}
    </p>

    {/* Decorative rolling view. Server-rendered with the first names so the grid has
        its shape before the script fills it; hidden entirely when script is off. */}
    <div class="roll" data-roll>
      {donors.slice(0, CELLS).map((d, i) => (
        <div class="cell" style={`--i:${i}`}>
          <article class="card is-on" data-name={d.name}>
            <span class="seal" aria-hidden="true">{initial(d.name)}</span>
            <div class="card-body"><DonorName d={d} /></div>
          </article>
        </div>
      ))}
    </div>

    <template data-roll-pool>
      {donors.map((d) => (
        <article class="card" data-name={d.name}>
          <span class="seal" aria-hidden="true">{initial(d.name)}</span>
          <div class="card-body"><DonorName d={d} /></div>
        </article>
      ))}
    </template>

    {/* Canonical roll: complete, in ledger order, and static, so nothing ever moves
        under a screen-reader cursor. It is also the no-script view. */}
    <ul class="donor-sr" role="list" data-roll-all hidden>
      {donors.map((d) => <li><DonorName d={d} /></li>)}
    </ul>

    <p class="roll-note">
      {lang === "id"
        ? "Nama ditampilkan bergantian dalam urutan acak, tanpa maksud pemeringkatan."
        : "Names rotate in random order, with no ranking implied."}
    </p>
  </section>
)}

<noscript>
  <style>
    /* No script: show the canonical list instead of the rolling grid. */
    .donatur .roll { display: none !important; }
    .donatur .donor-sr[hidden] {
      display: grid !important;
      position: static;
      width: auto; height: auto;
      margin: 0 auto; padding: 0;
      clip-path: none;
      white-space: normal;
      overflow: visible;
      max-width: 460px;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px 12px;
      list-style: none;
      text-align: left;
    }
  </style>
</noscript>

<style>
  .donatur {
    background: var(--paper);
    padding: 70px 30px;
  }
  .donatur .eyebrow { color: var(--red); }

  .lead {
    font-family: var(--font-display);
    font-style: italic;
    text-align: center;
    color: var(--ink);
    opacity: 0.85;
    max-width: 460px;
    margin: 0 auto 2.6rem;
    font-size: 16px;
    line-height: 1.6;
  }

  .roll {
    position: relative;
    max-width: 460px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 12px;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
    /* stretch to the cell so seals align across a line regardless of how many
       lines of text each entry has */
    height: 100%;
  }

  .seal {
    flex: 0 0 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--red-deep);
    color: var(--gold-pale);
    font-family: var(--font-cap);
    font-size: 15px;
    line-height: 1;
    user-select: none;
  }

  .card-body { min-width: 0; }

  /* Outgoing and incoming cards share one grid area, so they cross-fade in place.
     --cell-h is the tallest donor card at the current width (measured by the
     script), so a cell never jumps between a one-line name and a three-line one. */
  .cell { display: grid; }
  .roll.is-rolling .cell { min-height: var(--cell-h, auto); }

  /* A hidden cell holding every card, used only to measure --cell-h. */
  .probe {
    position: absolute;
    inset: 0 auto auto 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* ── rolling mode ── */
  .roll.is-rolling .card {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    user-select: none;
    transition: opacity 900ms cubic-bezier(0.4, 0, 0.2, 1), transform 950ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Transitions read their timing from the destination state, so the leaving card
     runs 0→900ms and the arriving one begins at 780ms: a dissolve, not a smear of
     two serif names crossing at half opacity. */
  .roll.is-rolling .card.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    user-select: auto;
    transition-delay: 780ms;
  }
  /* The first fill on load appears without the fade. */
  .roll.is-rolling .card.is-instant { transition: none; }

  /* The names still change for reduced-motion users — that is the point of the
     section — but they cross-fade in place with no travel. */
  @media (prefers-reduced-motion: reduce) {
    .roll.is-rolling .card {
      transform: none;
      transition: opacity 700ms ease !important;
      transition-delay: 0ms !important;
    }
    .roll.is-rolling .card.is-on {
      transform: none;
      transition-delay: 700ms !important;
    }
    .roll.is-rolling .card.is-instant { transition: none !important; }
  }

  .donor-sr {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .donor-sr[hidden] { display: none; }

  .roll-note {
    max-width: 460px;
    margin: 1.6rem auto 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    color: var(--ink);
    /* 0.55 measured 4.07:1 on --paper and failed AA. This is the line that
       stops the roll being read as a ranking; it has to be legible. */
    opacity: 0.68;
  }

  @media (min-width: 720px) {
    .roll { max-width: 760px; gap: 26px 32px; }
    .card { gap: 14px; }
    .seal { flex-basis: 44px; height: 44px; font-size: 19px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.anim-ready) [data-reveal] .roll { opacity: 0; transform: translateY(10px); }
    :global(.anim-ready) [data-reveal].in-view .roll {
      opacity: 1;
      transform: none;
      transition: opacity 0.6s ease, transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }
</style>

<script>
  const roll = document.querySelector<HTMLElement>("[data-roll]");
  const pool = document.querySelector<HTMLTemplateElement>("[data-roll-pool]");
  const srList = document.querySelector<HTMLElement>("[data-roll-all]");

  // Words that say who someone is rather than which person: honorifics, family
  // and company markers, and the generic names on the shared sponsor/donor links.
  const STOP = new Set([
    "bapak", "ibu", "bp", "bpk", "pak", "bu", "mr", "mrs", "ms", "miss", "ko", "koh", "ci", "cik",
    "sdr", "sdri", "saudara", "saudari", "tn", "ny", "nn", "alm", "almh", "keluarga", "kel", "family",
    "beserta", "dan", "and", "the", "pt", "cv", "tk", "toko", "ud", "group", "suhu", "dr", "prof",
    "romo", "ym", "umat", "sponsor", "donatur", "tamu", "vip", "yth",
  ]);
  const fold = (s: string) => s.normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const wordsOf = (s: string) =>
    fold(s).split(/[^\p{L}\p{N}]+/u).filter((w) => w.length >= 2 && !STOP.has(w));
  const escape = (w: string) => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const shuffle = <T,>(a: T[]) => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };

  // Guest's own name first. Each word of the invitation name (?to=) is matched as a
  // whole word against every donor, so "Bapak Michael" brings up both Michaels and
  // "Bapak/Ibu Lo Ce Min" brings Lo Ce Min first, then the other Lo family names.
  // More words matched ranks higher; ties and everyone else are shuffled.
  const arrange = (names: string[], guest: string) => {
    const patterns = [...new Set(wordsOf(guest))].map(
      (w) => new RegExp(`(?:^|[^\\p{L}\\p{N}])${escape(w)}(?![\\p{L}\\p{N}])`, "u"),
    );
    const scored = shuffle(names.map((name, i) => ({
      i,
      score: patterns.filter((re) => re.test(fold(name))).length,
    })));
    return scored.sort((a, b) => b.score - a.score).map((s) => s.i);
  };

  if (roll && pool && srList) {
    const cards = Array.from(pool.content.querySelectorAll<HTMLElement>(".card"));
    const cells = Array.from(roll.querySelectorAll<HTMLElement>(".cell"));
    const N = cards.length;
    const COLS = 2;
    const LINES = Math.ceil(cells.length / COLS);
    const params = new URLSearchParams(location.search);
    const order = arrange(cards.map((c) => c.dataset.name ?? ""), params.get("to") || params.get("nama") || "");

    // The rolling grid is decoration; the sr-only list is the real roll.
    // aria-hidden must be the string "true" — toggleAttribute would set "".
    roll.classList.add("is-rolling");
    roll.setAttribute("aria-hidden", "true");
    srList.hidden = false;

    const put = (cell: HTMLElement, donor: number, instant: boolean) => {
      const incoming = cards[donor].cloneNode(true) as HTMLElement;
      const outgoing = Array.from(cell.children) as HTMLElement[];
      if (instant) {
        incoming.classList.add("is-on", "is-instant");
        cell.replaceChildren(incoming);
        requestAnimationFrame(() => requestAnimationFrame(() => incoming.classList.remove("is-instant")));
        return;
      }
      cell.append(incoming);
      void incoming.offsetWidth; // commit the hidden state so the fade runs
      outgoing.forEach((c) => c.classList.remove("is-on"));
      incoming.classList.add("is-on");
      window.setTimeout(() => outgoing.forEach((c) => c.remove()), 2000);
    };

    // First screen: the first eight of the arranged order, in reading order.
    const fillFirst = () => cells.forEach((cell, k) => put(cell, order[k % N], true));
    fillFirst();
    let restart = () => {};

    // Height: stack every card in one hidden cell at the live cell width.
    const measure = () => {
      // A shallow clone keeps Astro's scoping attribute, so the .cell/.probe rules apply.
      const probe = cells[0].cloneNode(false) as HTMLElement;
      probe.classList.add("probe");
      probe.style.width = `${cells[0].getBoundingClientRect().width}px`;
      probe.style.minHeight = "0";
      cards.forEach((c) => {
        const clone = c.cloneNode(true) as HTMLElement;
        clone.classList.add("is-on", "is-instant");
        probe.append(clone);
      });
      roll.append(probe);
      roll.style.setProperty("--cell-h", `${probe.getBoundingClientRect().height}px`);
      probe.remove();
    };
    measure();
    let lastWidth = roll.clientWidth;
    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (roll.clientWidth !== lastWidth) { lastWidth = roll.clientWidth; measure(); }
      }, 150);
    });
    document.fonts?.ready.then(measure);

    if (N > cells.length) {
      // Lines turn in order, top to bottom, both names in a line together (the
      // second a beat behind), always taking the next two names in the arranged
      // order. The screen is then a sliding window over the order, so nobody can
      // appear twice at once and everyone comes round before anyone repeats.
      const BEAT = 6000;
      const LAG = 450;
      let next = cells.length % N;
      let line = 0;
      let timer: number | undefined;
      const lagTimers = new Set<number>();
      let onScreen = false;
      let held = false;
      let observed = false;

      const tick = () => {
        const [first, second] = [line * COLS, line * COLS + 1];
        put(cells[first], order[next], false);
        next = (next + 1) % N;
        if (cells[second]) {
          const donor = order[next];
          next = (next + 1) % N;
          const t = window.setTimeout(() => { lagTimers.delete(t); put(cells[second], donor, false); }, LAG);
          lagTimers.add(t);
        }
        line = (line + 1) % LINES;
        timer = window.setTimeout(tick, BEAT);
      };

      const shouldRun = () => onScreen && !held && !document.hidden;
      const sync = () => {
        if (!shouldRun()) {
          window.clearTimeout(timer); timer = undefined;
          return;
        }
        if (timer === undefined) timer = window.setTimeout(tick, BEAT);
      };

      new IntersectionObserver((es) => { observed = true; onScreen = es[0].isIntersecting; sync(); },
        { threshold: 0.2 }).observe(roll);
      document.addEventListener("visibilitychange", sync);

      // No hover pause: the roll fills most of the section, so a resting cursor
      // would freeze it indefinitely. Focus pauses; scrolling away or hiding the
      // tab stops it.
      roll.addEventListener("focusin", () => { held = true; sync(); });
      roll.addEventListener("focusout", () => { held = false; sync(); });

      restart = () => {
        window.clearTimeout(timer); timer = undefined;
        lagTimers.forEach((t) => window.clearTimeout(t)); lagTimers.clear();
        next = cells.length % N;
        line = 0;
        fillFirst();
        sync();
      };

      // Safety net for a browser that never delivers an IntersectionObserver entry.
      window.setTimeout(() => {
        if (!observed && !held) { onScreen = true; sync(); }
      }, 4000);
    }

    // Opening the invitation starts the roll from its first screen — the guest's
    // own name first — however long the page sat behind the cover, and so does
    // coming back to the page from the browser's back/forward cache.
    document.getElementById("openBtn")?.addEventListener("click", () => restart());
    window.addEventListener("pageshow", (e) => { if (e.persisted) restart(); });
  }
</script>
