---
import { invitation } from "~/config/invitation";
import { type Lang, pick } from "~/i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<!-- INTRO LETTER -->
<section class="intro">
  <div class="eyebrow">{lang === "id" ? "Salam Kebajikan" : "Greetings of Virtue"}</div>
  <div class="section-han">恭 請 光 臨</div>
  <div class="section-han-roman">{lang === "id" ? "Mohon Berkenan Hadir" : "Kindly Honour Us"}</div>
  <div class="divider"><span class="line"></span><span class="dot"></span><span class="line"></span></div>

  <div class="salam-stamp">慈 悲 喜 捨</div>

  <div class="intro-body">
    <p class="salute">{pick(invitation.greeting, lang)}, {pick(invitation.honorific, lang)}</p>
    {lang === "id" ? (
      <>
        <p>
          Dalam rangka menyambut <em>Sejit YMS Tjie Thien Ta Sen</em> & <em>HUT Tjie Thien Ta Sen Bio Ke-43 Tahun</em>, kami akan menyelenggarakan <strong>Kirab Budaya & Ruwat Bumi 2026</strong>.
        </p>
        <p>
          Sebagai penghormatan dan ungkapan rasa terima kasih kami kepada YMS Tjie Thien Ta Sen sebagai dewa pemberi berkah dan pembimbing yang kita yakini selalu memberikan kesehatan, keselamatan, perlindungan, dan kemakmuran bagi kita semua.
        </p>
        <p>
          Demi kelancaran dan suksesnya acara ini, kami mengharapkan kehadiran dan partisipasi Bapak — Ibu sekalian.
        </p>
      </>
    ) : (
      <>
        <p>
          In welcoming the <em>Birthday of YMS Tjie Thien Ta Sen</em> & the <em>43rd Anniversary of Tjie Thien Ta Sen Bio</em>, we will hold the <strong>Kirab Budaya & Ruwat Bumi 2026</strong>.
        </p>
        <p>
          As tribute and gratitude to YMS Tjie Thien Ta Sen — the deity of blessing and guidance who continually grants health, safety, protection, and prosperity to us all.
        </p>
        <p>
          For the smooth and joyful conduct of this event, we sincerely hope for your presence and participation.
        </p>
      </>
    )}

    {/* The letter had no sign-off — it simply stopped after the invitation.
        An undangan closes by saying who is inviting you. Senior name first. */}
    <div class="signoff">
      <div class="signoff-salute">
        {lang === "id" ? "Hormat kami," : "Respectfully,"}
      </div>
      <div class="signoff-body">
        {lang === "id" ? "Panitia Kirab Budaya & Ruwat Bumi 2026" : "The Kirab Budaya & Ruwat Bumi 2026 Committee"}
      </div>
      <div class="signoff-names">
        {invitation.committee.leadership.map((p) => (
          <div class="signoff-person">
            <span class="s-name">{p.name}</span>
            <span class="s-role">{p.role}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- HERO QUOTE -->
<div class="hero-img">
  <picture>
    <source srcset="/gallery/altar-2-v2.webp" type="image/webp" />
    <img src="/gallery/altar-2-v2.jpeg" alt="" loading="lazy" decoding="async" width="1600" height="800" />
  </picture>
  <div class="quote">
    <div class="han">齊天大聖</div>
    <div class="han-roman bright">Tjie Thien Ta Sen</div>
    <p>
      {lang === "id"
        ? "“Tjie Thien Ta Sen — Sang Pemberi Berkah, pembimbing keselamatan, perlindungan, dan kemakmuran.”"
        : "“Tjie Thien Ta Sen — Giver of Blessings, guide of safety, protection, and prosperity.”"}
    </p>
  </div>
</div>

<style>
  .signoff {
    max-width: 460px;
    margin: 2.4rem auto 0;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(180, 133, 54, 0.35);
    text-align: center;
  }
  .signoff-salute {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--ink);
    opacity: 0.85;
  }
  .signoff-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    color: var(--ink);
    opacity: 0.7;
    margin-top: 2px;
  }
  /* Two names side by side once there is room; stacked on a phone so neither
     is squeezed into a column too narrow for the honorific. */
  .signoff-names {
    display: grid;
    gap: 22px;
    margin-top: 1.6rem;
  }
  .signoff-person { display: flex; flex-direction: column; gap: 4px; }
  .s-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 19px;
    line-height: 1.25;
    color: var(--ink);
  }
  .s-role {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  @media (min-width: 560px) {
    .signoff-names { grid-template-columns: 1fr 1fr; gap: 18px 24px; }
  }
  @media (min-width: 720px) {
    .s-name { font-size: 21px; }
    .s-role { font-size: 11px; }
  }
</style>
