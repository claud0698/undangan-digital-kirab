---
export const prerender = false;

import { getLiveSession } from "~/lib/auth";
import { listGuests, getAdminState, type Guest } from "~/lib/db";
import { CATEGORIES, SALUTATIONS } from "~/lib/categories";
import AdminStats from "~/components/AdminStats.astro";

const session = await getLiveSession(Astro.cookies);
const guests: Guest[] = session ? await listGuests() : [];
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const loginError = Astro.url.searchParams.get("error");

// Self-service state for the signed-in admin.
//   showTour          — has never finished or skipped the walkthrough, so it
//                       opens by itself. Once. The Panduan button reopens it.
//   passwordIsInitial — password_changed_at is still null, i.e. they are using
//                       whatever whoever created the account handed them.
const adminState = session ? await getAdminState(session.id) : null;
const showTour = !!session && !adminState?.onboarded_at;
const passwordIsInitial = !!session && !adminState?.password_changed_at;
// Asked to change it at sign-in. A prompt, not a lock — their current password
// keeps working, and postponing just means being asked again next time.
const mustChangePassword = !!session && adminState?.password_change_required === true;

// The walkthrough. Images are of the tool itself, shot against invented guests
// — never a real guest list, since public/ is served to anyone who asks.
const TOUR = [
  {
    img: "/admin-demo/1-ringkasan.webp", w: 1000, h: 948,
    title: "Selamat datang di Panel Admin",
    body: "Di sini Anda membuat undangan pribadi untuk setiap tamu — satu tamu, satu tautan. Ringkasan di atas selalu menunjukkan berapa undangan sudah dibuat dan berapa yang sudah dibuka.",
  },
  {
    img: "/admin-demo/2-tambah-tamu.webp", w: 1000, h: 896,
    title: "1. Tambahkan tamu",
    body: "Isi nama, alamat, dan kategori, lalu tekan Tambah. Sebutan seperti Bapak atau Ibu boleh dikosongkan. Tautan pribadi tamu terisi otomatis dari namanya.",
  },
  {
    img: "/admin-demo/3-tautan.webp", w: 1000, h: 662,
    title: "2. Kirim tautannya",
    body: "Setiap tamu punya tautannya sendiri. Tekan Salin untuk menyalin, atau tombol hijau WhatsApp untuk langsung mengirimkannya beserta ucapan.",
  },
  {
    img: "/admin-demo/4-status.webp", w: 1580, h: 1236,
    title: "3. Pantau yang sudah membuka",
    body: "Kolom Dibuka terisi sendiri. Abu-abu berarti belum dibuka, kuning berarti tautannya sudah dikunjungi, hijau berarti tamu menekan Buka Undangan. Angka di sebelahnya jumlah kunjungan.",
  },
  {
    img: "/admin-demo/5-ubah-sandi.webp", w: 1000, h: 1220,
    title: "4. Ganti kata sandi Anda",
    body: "Kata sandi pertama Anda dibuatkan pengurus, jadi kotak ini terbuka sendiri saat Anda masuk. Kata sandi lama tetap berlaku sampai Anda menggantinya — tekan Nanti saja bila sedang buru-buru, nanti ditanyakan lagi.",
  },
];

const prettyLink = (g: Pick<Guest, "slug">) => (g.slug ? `${site}/undangan/${g.slug}` : "");
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat("id-ID", {
    day: "numeric", month: "short", year: "numeric",
    hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta",
  }).format(new Date(iso));

// Open-tracking status: opened (pressed "Buka Undangan") > visited (landed via
// the link) > belum (neither). See /api/track + CoverGate.
type OpenState = "opened" | "visited" | "none";
const openState = (g: Guest): OpenState =>
  (g.open_count ?? 0) > 0 ? "opened" : (g.visit_count ?? 0) > 0 ? "visited" : "none";
const STATE_LABEL: Record<OpenState, string> = { opened: "Dibuka", visited: "Dikunjungi", none: "Belum dibuka" };
const lastSeen = (g: Guest) => g.last_opened_at ?? g.last_visited_at ?? null;
const seenTitle = (g: Guest) => {
  const t = lastSeen(g);
  return t ? `Terakhir: ${fmtDate(t)}` : "Belum ada kunjungan";
};
const openedTotal = guests.filter((g) => (g.open_count ?? 0) > 0).length;
// Exclusive of the opened ones, matching openState() and the AdminStats panel.
// Counting opened guests as "dikunjungi" too would put two different numbers
// under the same word on one screen.
const visitedTotal = guests.filter((g) => openState(g) === "visited").length;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Admin — Undangan Kirab 2026</title>
    <!-- is:global — rows are (re)built in JS (buildRow) and inserted as plain
         innerHTML, which does NOT carry Astro's scope token. Scoped styles would
         skip those dynamic rows, leaving freshly-added guests unstyled/cramped. -->
    <style is:global>
      :root {
        --bg: #0f0b0b; --panel: #17110f; --line: #2c211c; --line2: #7a6553;
        --gold: #d8a847; --gold-bright: #f0c869; --text: #efe6d8; --muted: #a99a86;
        --red: #b5321f; --ok: #2f7d4f;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      a { color: var(--gold-bright); }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 20px 16px 80px; }
      h1 { font-size: 20px; margin: 0; color: var(--gold-bright); letter-spacing: .02em; }
      .sub { color: var(--muted); font-size: 13px; margin-top: 2px; }
      button, input, select { font: inherit; color: inherit; }
      .btn {
        background: var(--gold); color: #1a1209; border: 0; border-radius: 8px;
        padding: 9px 16px; font-weight: 600; cursor: pointer; white-space: nowrap;
      }
      .btn:hover { background: var(--gold-bright); }
      .btn:disabled { opacity: .5; cursor: default; }
      .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--line2); }
      .btn-ghost:hover { color: var(--text); border-color: var(--gold); }
      .btn-sm { padding: 6px 10px; font-size: 13px; border-radius: 6px; }
      .btn-danger { color: #e8a99a; border-color: #4a2a24; }
      .btn-danger:hover { color: #fff; background: var(--red); border-color: var(--red); }
      /* compact icon-only button — used for row delete so it fits the narrow column */
      .btn-icon { display: inline-grid; place-items: center; padding: 6px; width: 30px; height: 30px; }
      .btn-icon svg { width: 15px; height: 15px; display: block; }
      /* copy buttons: filled gold + dark text so "Salin" is clearly readable */
      .btn[data-copy] { background: var(--gold); color: #1a1209; border: 0; font-weight: 700; }
      .btn[data-copy]:hover { background: var(--gold-bright); color: #1a1209; }
      /* WhatsApp share button */
      .btn-wa { background: #25d366; color: #08351c; border: 0; }
      .btn-wa:hover { background: #20bd5a; color: #052a15; }
      .btn-wa svg { width: 16px; height: 16px; display: block; }

      /* ── login ── */
      .login { max-width: 360px; margin: 12vh auto 0; padding: 28px 24px;
        background: var(--panel); border: 1px solid var(--line); border-radius: 14px; }
      .login h1 { text-align: center; margin-bottom: 4px; }
      .login .sub { text-align: center; margin-bottom: 22px; }
      .field { margin-bottom: 14px; }
      .field label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .08em; }
      .field input {
        /* 16px or iOS zooms on focus and never zooms back out */
        width: 100%; padding: 12px; font-size: 16px; background: #100c0a; border: 1px solid var(--line2);
        border-radius: 8px; outline: none;
      }
      .field input:focus { border-color: var(--gold); }
      /* ── password peek toggle ── */
      .input-wrap { position: relative; }
      .input-wrap input { padding-right: 44px; }
      .peek {
        position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
        display: grid; place-items: center; width: 34px; height: 34px;
        background: transparent; border: 0; border-radius: 7px;
        color: var(--muted); cursor: pointer; padding: 0;
      }
      .peek:hover { color: var(--text); }
      .peek:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }
      .peek svg { width: 19px; height: 19px; display: block; }
      .peek .icon-off { display: none; }
      .peek.showing .icon-on { display: none; }
      .peek.showing .icon-off { display: block; }
      .login .btn { width: 100%; padding: 12px; margin-top: 6px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; }
      /* login spinner — shown while the POST is in flight */
      .spinner {
        width: 16px; height: 16px; border-radius: 50%; flex: 0 0 auto;
        border: 2px solid rgba(26, 18, 9, .35); border-top-color: #1a1209;
        animation: spin .6s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 1.4s; } }
      .err { background: #3a1712; border: 1px solid #6e2a1e; color: #f0c0b4;
        padding: 10px 12px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }

      /* ── dashboard header ── */
      .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
      .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 16px; }
      .search { flex: 1; min-width: 180px; }
      .search input {
        width: 100%; padding: 10px 12px; background: var(--panel); border: 1px solid var(--line2);
        border-radius: 8px; outline: none;
      }
      .search input:focus { border-color: var(--gold); }
      .sort-select {
        padding: 10px 12px; background: var(--panel); border: 1px solid var(--line2);
        border-radius: 8px; outline: none; cursor: pointer;
      }
      .sort-select:focus { border-color: var(--gold); }
      .count { color: var(--muted); font-size: 13px; }

      .pager { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 18px; }
      .pager .page-label { color: var(--muted); font-size: 13px; min-width: 90px; text-align: center; }

      /* ── add form ── */
      .add {
        display: grid;
        /* Fluid: each field claims a min of 190px and shares leftover space; when a
           column can no longer fit 190px, the grid drops it to a new line on its
           own — no hard breakpoints, graceful from phone to wide desktop. */
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px 14px; background: var(--panel); border: 1px solid var(--line);
        border-radius: 12px; padding: 16px; margin-bottom: 18px; align-items: start;
      }
      .add-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
      .add input, .add select {
        width: 100%; padding: 10px 11px; background: #100c0a; border: 1px solid var(--line2);
        border-radius: 8px; outline: none; font-size: 16px; /* 16px: readable + avoids iOS focus-zoom */
      }
      .cat-select, .search input, .cell[contenteditable] { font-size: 15px; }
      .add input:focus, .add select:focus { border-color: var(--gold); }
      .add select:invalid { color: var(--muted); }
      /* One-line label (the "*"/"(opsional)" stay inline); nowrap keeps every
         title a single line so all inputs align across the row. Titles fit the
         190px min column, so this never overflows. */
      .add .field-title { white-space: nowrap; font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--gold-pale, #e9cf86); }
      .add .field-title .req { color: #e0894a; }
      .add .field-title .opt { font-weight: 400; color: var(--muted); }
      .add .hint { font-size: 13px; line-height: 1.35; color: #8a7c6a; overflow-wrap: anywhere; }
      .add .hint code { overflow-wrap: anywhere; word-break: break-all; }
      /* button fills its own cell and bottom-aligns with the inputs via the
         hidden spacer label above it */
      .add .btn { width: 100%; }
      .add .btn-field .field-title { visibility: hidden; }

      /* ── grid (table on desktop) ── */
      .grid { width: 100%; table-layout: fixed; border-collapse: collapse; background: var(--panel);
        border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
      .grid tbody td { overflow: hidden; text-overflow: ellipsis; }
      .grid tbody td .cell { overflow-wrap: anywhere; }
      .grid thead th {
        text-align: left; font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
        color: var(--muted); padding: 11px 12px; border-bottom: 1px solid var(--line2); font-weight: 600;
      }
      .grid tbody td { padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      .grid tbody tr:last-child td { border-bottom: 0; }
      .cell[contenteditable] { outline: none; border-radius: 6px; padding: 4px 6px; min-height: 20px; cursor: text; }
      .cell[contenteditable]:hover { background: #1e1613; }
      .cell[contenteditable]:focus { background: #241a15; box-shadow: inset 0 0 0 1px var(--gold); }
      .cell.slug { font-family: var(--font-mono); font-size: 13px; color: var(--gold-bright); }
      .cat-select {
        background: #100c0a; border: 1px solid var(--line2); border-radius: 7px;
        padding: 6px 8px; outline: none; max-width: 100%;
      }
      .cat-select:focus { border-color: var(--gold); }
      .link-col { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
      .link-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
      .link-row .tag { flex: 0 0 56px; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
      /* single-line, truncated URL — full URL is available via the Salin button / hover */
      .link-row a { flex: 1; min-width: 0; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .row-actions { display: flex; gap: 6px; justify-content: flex-end; }
      .date-cell { color: var(--muted); font-size: 12.5px; white-space: nowrap; }
      /* ── open-tracking status ── */
      .stat { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
      .stat .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; background: #5a4a3c; }
      .stat.opened .dot { background: var(--ok); box-shadow: 0 0 6px #2f7d4faa; }
      .stat.visited .dot { background: var(--gold); }
      .stat .lbl { font-size: 12.5px; }
      .stat .nums { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
      .summary { color: var(--muted); font-size: 13px; }
      .summary strong { color: var(--gold-bright); font-weight: 600; }
      .saving { opacity: .5; }
      .empty-state { text-align: center; color: var(--muted); padding: 40px 12px; }

      /* ── list loading placeholder ──
         The server renders rows in DB order; the inline script then re-sorts
         (default: Terbaru) + paginates. Hiding the list until that's done avoids
         a visible reshuffle. .wrap starts with .loading (in the HTML) so the
         first paint already shows the placeholder, not the unsorted rows. */
      .list-loading { display: none; align-items: center; justify-content: center; gap: 11px;
        padding: 52px 12px; color: var(--muted); font-size: 14px; }
      .list-loading .spinner { width: 20px; height: 20px; border-width: 3px;
        border-color: rgba(216, 168, 71, .25); border-top-color: var(--gold); }
      .wrap.loading .grid,
      .wrap.loading #pager,
      .wrap.loading #emptyState { display: none !important; }
      .wrap.loading .list-loading { display: flex; }

      .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
        background: var(--ok); color: #fff; padding: 10px 18px; border-radius: 999px; font-size: 14px;
        opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 50; max-width: 90vw; text-align: center; }
      .toast.show { opacity: 1; pointer-events: auto; }
      .toast-action { margin-left: 12px; background: rgba(0,0,0,.28); color: #fff;
        border: 1px solid rgba(255,255,255,.45); border-radius: 999px;
        padding: 6px 14px; font-size: 13px; font-weight: 700; cursor: pointer; }
      .toast-action:hover { background: rgba(0,0,0,.45); }
      .toast.err { background: var(--red); }

      /* ── mobile ── (the add form reflows on its own via auto-fit) */
      @media (max-width: 1024px) {
        .cat-select, .sort-select, .cell[contenteditable], .search input { font-size: 16px; }
        /* toolbar: search full width on its own row; filter + sort share the next row */
        .toolbar { gap: 8px; }
        .toolbar .search { flex: 1 1 100%; min-width: 0; }
        .toolbar .sort-select { flex: 1 1 0; min-width: 0; }
        .toolbar .count { flex: 1 1 100%; }
        .grid, .grid thead, .grid tbody, .grid tr, .grid td { display: block; width: 100%; }
        .grid { border: 0; background: transparent; }
        .grid thead { display: none; }
        .grid tbody tr {
          background: #221611; border: 1px solid #3d2b20; border-left: 3px solid var(--gold);
          border-radius: 12px; margin-bottom: 12px; padding: 6px 4px;
        }
        .grid tbody td { border: 0; padding: 8px 12px; display: flex; gap: 12px; align-items: flex-start; }
        .grid tbody td + td { border-top: 1px solid var(--line); }
        .grid tbody td::before {
          content: attr(data-label); flex: 0 0 90px; color: var(--muted); font-size: 12px;
          text-transform: uppercase; letter-spacing: .05em; padding-top: 6px;
        }
        .cell[contenteditable], .cat-select { flex: 1; }
        /* links: URL on its own full-width line, then [tag ........ Salin] below */
        .link-col { flex: 1; gap: 10px; }
        .link-row { flex-wrap: wrap; gap: 4px 8px; align-items: center; }
        .link-row a { order: 0; flex: 1 1 100%; font-size: 13px; }
        .link-row .tag { order: 1; flex: 0 0 auto; }
        .link-row .btn { order: 2; margin-left: auto; }
        .row-actions { flex: 1; justify-content: flex-start; }
        .date-cell { font-size: 14px; }

        /* ── phone: a card per guest, not a transcribed table row ──
           Ten stacked label/value pairs made one guest 537px tall, so a page of
           100 was ~53,000px of scrolling, and the guest's name carried no more
           weight than "Diaudit oleh". Keep what a volunteer acts on; the rest
           stays in the DOM for search and CSV, just not shouting. */
        .grid tbody td[data-label="Ditambah"],
        .grid tbody td[data-label="Diaudit oleh"],
        .grid tbody td[data-label="Tautan Kustom"] { display: none; }
        .link-row a { display: none; }

        /* the name leads the card */
        .grid tbody td[data-label="Nama"]::before { display: none; }
        .grid tbody td[data-label="Nama"] .cell { font-size: 18px; font-weight: 600; }

        /* every control a thumb has to hit */
        .btn-icon { width: 44px; height: 44px; padding: 0; }
        .btn-sm { padding: 12px 16px; }   /* 42px measured at 11px; 44 is the floor */
        .toolbar .btn, .pager .btn { min-height: 44px; }
        .cat-select,
        .cell[contenteditable] {
          min-height: 44px; padding: 10px 12px;
          background: #100c0a; border: 1px solid var(--line2); border-radius: 8px;
        }
        .cell[contenteditable]:focus { border-color: var(--gold); }
        .link-row .btn { flex: 1 1 auto; text-align: center; }

        /* Delete: a bare icon gives no warning about what it does. On the card
           it gets its word back, and sits away from Salin so a thumb reaching
           for one cannot land on the other. */
        .grid tbody td[data-label="Aksi"] { justify-content: flex-end; }
        .grid tbody td[data-label="Aksi"]::before { display: none; }
        .row-actions .btn-danger { width: auto; padding: 0 18px; gap: 8px; }
        .row-actions .btn-danger::after { content: "Hapus"; font-size: 14px; font-weight: 600; }

        /* The save confirmation has to live where the eye already is: a toast
           pinned to the bottom sits behind the Android keyboard, which stays
           up through the tap-cell / type / tap-next-cell loop. */
        .toast { top: 12px; bottom: auto; }
        .grid tbody tr[data-saved] td[data-label="Nama"] .cell { border-color: #3f7d54; }
        .grid tbody tr[data-saved]::after {
          content: "✓ Tersimpan"; display: block;
          margin: 2px 12px 8px; font-size: 13px; color: #7fc79b;
        }
      }
      /* ── top bar actions ── */
      .top-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
      .logout-form { margin: 0; display: flex; }
      /* Four identical ghost buttons put signing out one mis-tap from exporting
         a CSV. Keluar is the only one of them with a consequence. */
      .btn-quit { color: #d8a08f; border-color: #4a2f28; }
      .btn-quit:hover { color: #fff; background: var(--red); border-color: var(--red); }

      /* ── "still on the handed-over password" nudge ── */
      .nudge {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        margin-bottom: 16px; padding: 11px 14px;
        background: #241a10; border: 1px solid #4a3a1c; border-left: 3px solid var(--gold);
        border-radius: 10px; color: #e6d8bd; font-size: 14px;
      }
      .nudge span { flex: 1; min-width: 200px; }

      /* ── modal sheet (change password) ── */
      .sheet {
        width: min(430px, calc(100vw - 24px)); padding: 24px 22px 20px;
        background: var(--panel); color: var(--text);
        border: 1px solid var(--line); border-radius: 14px;
        box-shadow: 0 24px 70px rgba(0,0,0,.6);
      }
      .sheet::backdrop { background: rgba(0,0,0,.66); }
      .sheet h2 { margin: 0 0 4px; font-size: 18px; color: var(--gold-bright); }
      .sheet-sub { margin: 0 0 18px; color: var(--muted); font-size: 13px; line-height: 1.45; }
      .sheet-x { position: absolute; top: 10px; right: 10px; margin: 0; }
      .icon-x {
        background: transparent; border: 0; color: var(--muted); cursor: pointer;
        width: 34px; height: 34px; border-radius: 8px; font-size: 24px; line-height: 1;
      }
      .icon-x:hover { color: var(--text); background: rgba(255,255,255,.06); }
      .sheet-why {
        margin: 0 0 12px; padding: 10px 12px; border-radius: 8px;
        background: #241a10; border: 1px solid #4a3a1c; border-left: 3px solid var(--gold);
        color: #e6d8bd; font-size: 13px; line-height: 1.5;
      }
      .sheet-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px; }
      .sheet-actions .btn { min-width: 96px; justify-content: center; display: inline-flex; align-items: center; gap: 8px; }
      .sheet-err {
        margin-top: 14px; padding: 10px 12px; border-radius: 8px;
        background: #3a1712; border: 1px solid #6b2a20; color: #f0bdb2; font-size: 13.5px;
      }
      /* Requirements are stated up front and tick as they are met, so the rule
         is never a surprise delivered by the server after pressing Simpan. */
      .rules { list-style: none; margin: 8px 0 0; padding: 0; }
      .rules li {
        position: relative; padding-left: 20px; font-size: 12.5px; color: var(--muted); line-height: 1.7;
      }
      .rules li::before { content: "○"; position: absolute; left: 2px; }
      .rules li.met { color: #86c79b; }
      .rules li.met::before { content: "✓"; }

      /* ── walkthrough ── */
      .tour {
        position: fixed; inset: 0; z-index: 60; display: flex;
        align-items: center; justify-content: center; padding: 16px;
        background: rgba(6,4,3,.82); overflow-y: auto;
      }
      .tour[hidden] { display: none; }
      .tour-card {
        position: relative; width: min(560px, 100%); margin: auto;
        background: var(--panel); border: 1px solid var(--line); border-radius: 16px;
        box-shadow: 0 24px 70px rgba(0,0,0,.6); padding: 18px 18px 14px;
      }
      .tour-x { position: absolute; top: 8px; right: 8px; z-index: 1; }
      .tour-step { margin: 0; }
      .tour-step[hidden] { display: none; }
      .tour-step img {
        display: block; width: 100%; height: auto; border-radius: 10px;
        border: 1px solid var(--line2); background: var(--bg);
        /* Cap the picture so the caption and Lanjut always stay on screen —
           a 4:5 shot on a 667px phone would otherwise push them below the fold.
           The screenshots already sit on --bg, so contain letterboxes invisibly. */
        max-height: 46vh; object-fit: contain; object-position: top;
      }
      .tour-step figcaption { padding: 14px 4px 0; }
      .tour-step h2 { margin: 0 0 6px; font-size: 17px; color: var(--gold-bright); }
      .tour-step p { margin: 0; font-size: 14px; line-height: 1.6; color: #d9cdbb; }
      .tour-foot {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line);
      }
      .dots { display: flex; gap: 7px; }
      .dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--line2); transition: background .2s; }
      .dots span.on { background: var(--gold); }
      .tour-btns { display: flex; gap: 8px; }

      @media (max-width: 1024px) {
        /* The 44px pass covered the guest card but not what arrived with the
           dialog and the tour: the eye toggle someone uses one-handed while
           typing a password they cannot see, the dialog close, and Undo —
           which is the only way back from a delete and was a 33px target. */
        .peek { width: 44px; height: 44px; right: 2px; }
        .input-wrap input { padding-right: 52px; }
        .icon-x { width: 44px; height: 44px; }
        .toast { display: flex; align-items: center; justify-content: center; gap: 10px; }
        .toast-action { margin-left: 0; min-height: 44px; padding: 10px 18px; }
      }

      @media (max-width: 600px) {
        .top { flex-direction: column; align-items: stretch; }
        .top-actions { justify-content: flex-start; }
        .top-actions .btn { flex: 1 1 auto; min-height: 44px; }
        .logout-form { flex: 1 1 auto; }
        .logout-form .btn { width: 100%; }
        .sheet { width: 100%; max-width: none; border-radius: 14px 14px 0 0; margin: auto auto 0; padding-bottom: 26px; }
        .sheet-actions .btn { flex: 1; min-height: 44px; }
        .nudge .btn { min-height: 44px; }
        /* dvh/svh, not vh: on Chrome Android vh is the URL-bar-retracted
           height, so a card sized in vh runs past the bottom of what is
           actually visible and the primary button lands below the fold. */
        .tour { padding: 0; align-items: flex-end; }
        .tour-card {
          border-radius: 14px 14px 0 0; padding: 16px 14px 12px;
          margin: auto 0 0;   /* auto on every side was beating align-items */
          max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain;
        }
        .tour-step img { max-height: 34svh; }
        .tour-foot {
          position: sticky; bottom: 0; background: var(--panel);
          margin-top: 12px; padding-bottom: 2px;
        }
        .sheet { max-height: 92dvh; overflow-y: auto; overscroll-behavior: contain; }
        .sheet-actions {
          position: sticky; bottom: -26px; background: var(--panel);
          padding-bottom: 26px; margin-bottom: -26px;
        }
        .tour-btns .btn { min-height: 44px; padding: 10px 18px; }
        .tour-x { width: 44px; height: 44px; }
      }

      @media (prefers-reduced-motion: reduce) { .dots span { transition: none; } }

    </style>
  </head>
  <body>
    {!session ? (
      <div class="login">
        <h1>Panel Admin</h1>
        <div class="sub">Undangan Kirab Budaya 2026</div>
        {loginError && (
          <div class="err">
            {loginError === "locked"
              ? "Terlalu banyak percobaan gagal. Coba lagi dalam beberapa menit."
              : "Username atau password salah."}
          </div>
        )}
        <form method="POST" action="/api/auth/login" id="loginForm">
          <div class="field">
            <label for="u">Username</label>
            <input id="u" name="username" autocomplete="username" required autofocus />
          </div>
          <div class="field">
            <label for="p">Password</label>
            <div class="input-wrap">
              <input id="p" name="password" type="password" autocomplete="current-password" required />
              <button type="button" class="peek" id="peekBtn" aria-label="Tampilkan kata sandi" aria-pressed="false" title="Tampilkan / sembunyikan">
                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" />
                </svg>
              </button>
            </div>
          </div>
          <button class="btn" type="submit" id="loginBtn"><span class="btn-label">Masuk</span></button>
        </form>
      </div>
      <script is:inline>
        // Show a spinner + disable while the login POST navigates, so a slow
        // scrypt verify / network round-trip gives immediate feedback.
        const lf = document.getElementById("loginForm");
        lf?.addEventListener("submit", () => {
          const b = document.getElementById("loginBtn");
          if (!b) return;
          b.disabled = true;
          b.innerHTML = '<span class="spinner" aria-hidden="true"></span><span class="btn-label">Memeriksa…</span>';
        });

        // Peek password: toggle the field between hidden and revealed.
        const peekBtn = document.getElementById("peekBtn");
        const pwInput = document.getElementById("p");
        peekBtn?.addEventListener("click", () => {
          const reveal = pwInput.type === "password";
          pwInput.type = reveal ? "text" : "password";
          peekBtn.classList.toggle("showing", reveal);
          peekBtn.setAttribute("aria-pressed", String(reveal));
          peekBtn.setAttribute("aria-label", reveal ? "Sembunyikan kata sandi" : "Tampilkan kata sandi");
          pwInput.focus();
        });
      </script>
    ) : (
      <div class="wrap loading" data-site={site}>
        <div class="top">
          <div>
            <h1>Manajemen Tamu</h1>
            <div class="sub">Login sebagai <strong>{session.username}</strong></div>
          </div>
          <div class="top-actions">
            <button class="btn btn-ghost btn-sm" id="tourBtn" type="button">Panduan</button>
            <button class="btn btn-ghost btn-sm" id="pwBtn" type="button">Ubah Sandi</button>
            <button class="btn btn-ghost btn-sm" id="csvBtn">Ekspor CSV</button>
            <form method="POST" action="/api/auth/logout" class="logout-form">
              <button class="btn btn-ghost btn-sm btn-quit" type="submit">Keluar</button>
            </form>
          </div>
        </div>

        <AdminStats guests={guests} />

        {passwordIsInitial && (
          <div class="nudge" id="pwNudge">
            <span>Anda masih memakai kata sandi yang diberikan saat akun dibuat.</span>
            <button class="btn btn-sm" type="button" data-open-pw>Ubah sekarang</button>
          </div>
        )}

        <!-- add guest — Sebutan opsional, sisanya wajib -->
        <form class="add" id="addForm">
          <label class="add-field">
            <span class="field-title">Sebutan <span class="opt">(opsional)</span></span>
            <input name="salutation" list="salutations" placeholder="mis. Bapak" autocomplete="off" />
            <datalist id="salutations">
              {SALUTATIONS.map((s) => <option value={s} />)}
            </datalist>
            <span class="hint">Panggilan, mis. <em>Bapak</em>, <em>Ibu</em>, <em>Prof.</em> — pilih atau ketik sendiri.</span>
          </label>
          <label class="add-field">
            <span class="field-title">Nama tamu <span class="req">*</span></span>
            <input name="name" placeholder="mis. Andri Wijaya" required autocomplete="off" />
            <span class="hint">Nama lengkap tamu, mis. <em>Andri Wijaya</em>.</span>
          </label>
          <label class="add-field">
            <span class="field-title">Alamat <span class="req">*</span></span>
            <input name="address" placeholder="mis. Jl. Melati 12, Tangerang" required autocomplete="off" />
            <span class="hint">Alamat / kota, mis. <em>Jl. Melati 12, Tangerang</em>.</span>
          </label>
          <label class="add-field">
            <span class="field-title">Kategori <span class="req">*</span></span>
            <select name="category" required>
              <option value="" disabled selected>Pilih kategori…</option>
              {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
            </select>
            <span class="hint">Golongan tamu untuk pengelompokan.</span>
          </label>
          <label class="add-field">
            <span class="field-title">Tautan Kustom <span class="opt">(opsional)</span></span>
            <input name="slug" autocapitalize="none" autocorrect="off" placeholder="tautan-kustom" autocomplete="off"
              pattern="[a-z0-9-]+" title="huruf kecil, angka, tanda hubung" />
            <span class="hint">Tautan pendek, mis. <em>andriwijaya</em> → <code>{site.replace(/^https?:\/\//, "")}/undangan/andriwijaya</code>. Terisi otomatis dari nama.</span>
          </label>
          <div class="add-field btn-field">
            <span class="field-title" aria-hidden="true">.</span>
            <button class="btn" type="submit">+ Tambah</button>
          </div>
        </form>

        <div class="toolbar">
          <div class="search"><input id="search" placeholder="Cari nama / alamat / kategori…" aria-label="Cari" /></div>
          <select id="catFilter" class="sort-select" aria-label="Filter kategori">
            <option value="">Semua Kategori</option>
            {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
          </select>
          <select id="sortBy" class="sort-select" aria-label="Urutkan">
            <option value="terbaru" selected>Urut: Terbaru</option>
            <option value="terlama">Urut: Terlama</option>
            <option value="nama-asc">Urut: Nama A–Z</option>
            <option value="nama-desc">Urut: Nama Z–A</option>
            <option value="kategori">Urut: Kategori</option>
          </select>
          <div class="count"><span id="count">{guests.length}</span> tamu</div>
          <div class="summary" id="summary"><strong>{openedTotal}</strong> dibuka · <strong>{visitedTotal}</strong> dikunjungi</div>
        </div>

        <div class="list-loading" aria-hidden="true"><span class="spinner"></span> Memuat daftar tamu…</div>
        <table class="grid">
          <thead>
            <tr>
              <th style="width:9%;">Sebutan</th>
              <th style="width:10%;">Nama</th>
              <th style="width:10%;">Alamat</th>
              <th style="width:11%;">Kategori</th>
              <th style="width:9%;">Tautan Kustom</th>
              <th style="width:17%;">Tautan Undangan</th>
              <th style="width:11%;">Dibuka</th>
              <th style="width:9%;">Ditambah</th>
              <th style="width:8%;">Diaudit oleh</th>
              <th style="width:6%;"></th>
            </tr>
          </thead>
          <tbody id="rows">
            {guests.map((g) => (
              <tr data-id={g.id} data-name={g.name} data-salutation={g.salutation ?? ""}
                  data-address={g.address ?? ""} data-slug={g.slug ?? ""}>
                <td data-label="Sebutan">
                  <div class="cell" contenteditable="plaintext-only" spellcheck="false" autocapitalize="words" data-field="salutation">{g.salutation ?? ""}</div>
                </td>
                <td data-label="Nama">
                  <div class="cell" contenteditable="plaintext-only" spellcheck="false" autocapitalize="words" data-field="name">{g.name}</div>
                </td>
                <td data-label="Alamat">
                  <div class="cell" contenteditable="plaintext-only" spellcheck="false" autocapitalize="words" data-field="address">{g.address ?? ""}</div>
                </td>
                <td data-label="Kategori">
                  <select class="cat-select" data-field="category">
                    {CATEGORIES.map((c) => <option value={c} selected={c === g.category}>{c}</option>)}
                  </select>
                </td>
                <td data-label="Tautan Kustom">
                  <div class="cell slug" contenteditable="plaintext-only" spellcheck="false" autocapitalize="words" data-field="slug">{g.slug ?? ""}</div>
                </td>
                <td data-label="Tautan">
                  <div class="link-col">
                    <div class="link-row" data-pretty-row style={g.slug ? "" : "display:none"}>
                      <a href={prettyLink(g)} target="_blank" rel="noopener" data-link-pretty>{prettyLink(g)}</a>
                      <button class="btn btn-ghost btn-sm" data-copy>Salin</button>
                      <button class="btn btn-icon btn-wa" data-wa aria-label="Bagikan via WhatsApp" title="Bagikan via WhatsApp">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.29-.15-1.72-.85-1.99-.94-.27-.1-.46-.15-.66.15-.19.29-.75.94-.92 1.13-.17.19-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.44-.87-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.51-.07-.15-.66-1.58-.9-2.16-.24-.57-.48-.49-.66-.5h-.56c-.19 0-.51.07-.77.36-.27.29-1.01.99-1.01 2.41 0 1.42 1.04 2.79 1.18 2.98.15.19 2.04 3.12 4.95 4.38.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.12.56-.09 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.34zM12.04 21.5h-.01a9.4 9.4 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.38 9.38 0 01-1.44-5.02c0-5.2 4.24-9.43 9.45-9.43 2.52 0 4.89.98 6.67 2.77a9.36 9.36 0 012.76 6.67c0 5.2-4.24 9.43-9.44 9.43zm8.04-17.47A11.32 11.32 0 0012.04 1C5.79 1 .7 6.08.7 12.33c0 1.99.52 3.94 1.51 5.66L.6 23.4l5.55-1.46a11.3 11.3 0 005.89 1.62h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.31-8.01z"/></svg>
                      </button>
                    </div>
                  </div>
                </td>
                <td data-label="Dibuka">
                  <div class={`stat ${openState(g)}`} data-stat data-visits={g.visit_count ?? 0} data-opens={g.open_count ?? 0} title={seenTitle(g)}>
                    <span class="dot"></span>
                    <span class="lbl">{STATE_LABEL[openState(g)]}</span>
                    <span class="nums">👁 {g.visit_count ?? 0} · 📂 {g.open_count ?? 0}</span>
                  </div>
                </td>
                <td data-label="Ditambah" class="date-cell">{fmtDate(g.created_at)}</td>
                <td data-label="Diaudit oleh" class="date-cell" data-audit>{g.audited_by ?? "—"}</td>
                <td data-label="Aksi">
                  <div class="row-actions">
                    <button class="btn btn-ghost btn-icon btn-danger" data-del aria-label="Hapus tamu" title="Hapus">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6" />
                        <line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="empty-state" id="emptyState" style={guests.length ? "display:none" : ""}>
          Belum ada tamu. Tambah tamu pertama di atas.
        </div>
        <div class="pager" id="pager" hidden></div>
      </div>
    )}

    {session && (
      <>
        <!-- ── change password ───────────────────────────────────────── -->
        <dialog class="sheet" id="pwDialog" aria-labelledby="pwTitle">
          <form method="dialog" class="sheet-x"><button class="icon-x" aria-label="Tutup">&times;</button></form>
          <h2 id="pwTitle">Ubah Kata Sandi</h2>
          {mustChangePassword && (
            <p class="sheet-why">
              Kata sandi Anda sekarang dibuatkan oleh pengurus, jadi orang lain pernah
              melihatnya. Mohon ganti dengan kata sandi yang hanya Anda yang tahu.
            </p>
          )}
          <p class="sheet-sub">Masuk berikutnya pakai kata sandi baru ini. Username tetap <strong>{session.username}</strong>.</p>

          <form id="pwForm" novalidate>
            <div class="field">
              <label for="pwCur">Kata sandi lama</label>
              <div class="input-wrap">
                <input id="pwCur" name="current" type="password" autocomplete="current-password" required />
                <button type="button" class="peek" data-peek aria-label="Tampilkan kata sandi" aria-pressed="false">
                  <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                  <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                </button>
              </div>
            </div>
            <div class="field">
              <label for="pwNew">Kata sandi baru</label>
              <div class="input-wrap">
                <input id="pwNew" name="next" type="password" autocomplete="new-password" required />
                <button type="button" class="peek" data-peek aria-label="Tampilkan kata sandi" aria-pressed="false">
                  <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                  <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                </button>
              </div>
              <ul class="rules" id="pwRules">
                <li data-rule="len">Minimal 8 karakter</li>
                <li data-rule="diff">Berbeda dari kata sandi lama</li>
              </ul>
            </div>
            <div class="field">
              <label for="pwConf">Ulangi kata sandi baru</label>
              <div class="input-wrap">
                <input id="pwConf" name="confirm" type="password" autocomplete="new-password" required />
                <button type="button" class="peek" data-peek aria-label="Tampilkan kata sandi" aria-pressed="false">
                  <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                  <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                </button>
              </div>
              <ul class="rules"><li data-rule="match">Sama dengan kata sandi baru</li></ul>
            </div>

            <div class="sheet-err" id="pwErr" hidden></div>
            <div class="sheet-actions">
              <button class="btn btn-ghost" type="button" data-close-pw>
                {mustChangePassword ? "Nanti saja" : "Batal"}
              </button>
              <button class="btn" type="submit" id="pwSave">Simpan</button>
            </div>
          </form>
        </dialog>

        <!-- ── first-run walkthrough ─────────────────────────────────── -->
        <div class="tour" id="tour" hidden role="dialog" aria-modal="true" aria-labelledby="tourTitle">
          <div class="tour-card">
            <button class="icon-x tour-x" id="tourSkip" type="button" aria-label="Lewati panduan">&times;</button>
            {TOUR.map((step, i) => (
              <figure class="tour-step" data-step={i} hidden={i > 0}>
                <img src={step.img} alt={step.title} width={step.w} height={step.h} decoding="async" />
                <figcaption>
                  <h2 id={i === 0 ? "tourTitle" : undefined}>{step.title}</h2>
                  <p>{step.body}</p>
                </figcaption>
              </figure>
            ))}
            <div class="tour-foot">
              <div class="dots" id="tourDots">
                {TOUR.map((_, i) => <span class={i === 0 ? "on" : ""} data-dot={i}></span>)}
              </div>
              <div class="tour-btns">
                <button class="btn btn-ghost btn-sm" id="tourPrev" type="button" hidden>Kembali</button>
                <button class="btn btn-sm" id="tourNext" type="button">Lanjut</button>
              </div>
            </div>
          </div>
        </div>

        {/* ── walkthrough + change password ── */}
        <script is:inline define:vars={{ autoTour: showTour, tourLen: TOUR.length, mustChange: mustChangePassword }}>
          // ---- peek toggles (every [data-peek] sits next to its own input) ----
          document.querySelectorAll("[data-peek]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const input = btn.parentElement.querySelector("input");
              const reveal = input.type === "password";
              input.type = reveal ? "text" : "password";
              btn.classList.toggle("showing", reveal);
              btn.setAttribute("aria-pressed", String(reveal));
              btn.setAttribute("aria-label", reveal ? "Sembunyikan kata sandi" : "Tampilkan kata sandi");
              input.focus();
            });
          });

          // ---- change password ----
          const dlg = document.getElementById("pwDialog");
          const pwForm = document.getElementById("pwForm");
          const cur = document.getElementById("pwCur");
          const next = document.getElementById("pwNew");
          const conf = document.getElementById("pwConf");
          const err = document.getElementById("pwErr");
          const save = document.getElementById("pwSave");
          const rules = document.querySelectorAll(".rules li");

          const setRule = (name, ok) =>
            document.querySelectorAll(`[data-rule="${name}"]`).forEach((li) => li.classList.toggle("met", ok));

          const check = () => {
            setRule("len", next.value.length >= 8);
            setRule("diff", next.value.length > 0 && next.value !== cur.value);
            setRule("match", conf.value.length > 0 && conf.value === next.value);
          };
          [cur, next, conf].forEach((i) => i.addEventListener("input", check));

          const openPw = () => {
            pwForm.reset();
            err.hidden = true;
            rules.forEach((li) => li.classList.remove("met"));
            // Any revealed field goes back to dots before the box is shown again.
            document.querySelectorAll("#pwDialog [data-peek]").forEach((b) => {
              b.classList.remove("showing");
              b.setAttribute("aria-pressed", "false");
              b.parentElement.querySelector("input").type = "password";
            });
            if (!dlg.open) dlg.showModal();
            cur.focus();
          };
          document.getElementById("pwBtn")?.addEventListener("click", openPw);
          document.querySelectorAll("[data-open-pw]").forEach((b) => b.addEventListener("click", openPw));
          document.querySelectorAll("[data-close-pw]").forEach((b) => b.addEventListener("click", () => dlg.close()));

          pwForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            err.hidden = true;
            // Say it here rather than spending a round-trip to be told the same.
            if (next.value.length < 8) return showErr("Kata sandi baru minimal 8 karakter.");
            if (next.value !== conf.value) return showErr("Konfirmasi kata sandi tidak cocok.");
            if (next.value === cur.value) return showErr("Kata sandi baru harus berbeda dari yang lama.");

            save.disabled = true;
            save.innerHTML = '<span class="spinner" aria-hidden="true"></span><span>Menyimpan…</span>';
            try {
              const res = await fetch("/api/auth/password", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ current: cur.value, next: next.value, confirm: conf.value }),
              });
              const data = await res.json().catch(() => ({}));
              if (!res.ok || !data.ok) throw new Error(data.error || "Gagal menyimpan.");
              dlg.close();
              document.getElementById("pwNudge")?.remove();
              window.kirabToast?.("Kata sandi diperbarui");
            } catch (e2) {
              showErr(e2.message);
            } finally {
              save.disabled = false;
              save.textContent = "Simpan";
            }
          });

          function showErr(msg) {
            err.textContent = msg;
            err.hidden = false;
          }

          // ---- walkthrough ----
          const tour = document.getElementById("tour");
          const steps = [...tour.querySelectorAll(".tour-step")];
          const dots = [...tour.querySelectorAll("[data-dot]")];
          const prevBtn = document.getElementById("tourPrev");
          const nextBtn = document.getElementById("tourNext");
          let at = 0;
          let marked = false;

          const render = () => {
            steps.forEach((f, i) => (f.hidden = i !== at));
            dots.forEach((d, i) => d.classList.toggle("on", i === at));
            prevBtn.hidden = at === 0;
            nextBtn.textContent = at === tourLen - 1 ? "Selesai" : "Lanjut";
          };
          const openTour = () => { at = 0; render(); tour.hidden = false; nextBtn.focus(); };
          // Finishing and skipping mean the same thing to the server: seen it,
          // stop opening it. Sent once per page, and a failure is not worth an
          // error in the admin's face — the worst case is it opens again.
          let closeTour = () => {
            tour.hidden = true;
            if (marked) return;
            marked = true;
            fetch("/api/auth/onboarded", { method: "POST" }).catch(() => { marked = false; });
          };

          nextBtn.addEventListener("click", () => {
            if (at === tourLen - 1) return closeTour();
            at += 1;
            render();
          });
          prevBtn.addEventListener("click", () => { at = Math.max(0, at - 1); render(); });
          // Called through the variable, never passed by reference: closeTour is
          // reassigned below when the password request has to follow the tour,
          // and a handler registered with the old value would keep the old one.
          document.getElementById("tourSkip").addEventListener("click", () => closeTour());
          tour.addEventListener("click", (e) => { if (e.target === tour) closeTour(); });
          document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !tour.hidden) closeTour(); });
          // Reopening from the button is just reading it again — it does not
          // need to re-tell the server anything.
          document.getElementById("tourBtn")?.addEventListener("click", () => { at = 0; render(); tour.hidden = false; });

          // First sign-in shows the walkthrough, and the password request waits its
          // turn rather than stacking a second box on top of the first.
          if (autoTour) {
            // Wrap, do not re-register: assigning .onclick on top of the
            // addEventListener above left both handlers live, so every tap
            // advanced two steps and a first-time reader never saw steps 2 or 4.
            const base = closeTour;
            closeTour = () => { base(); if (mustChange) setTimeout(openPw, 350); };
            openTour();
          } else if (mustChange) {
            openPw();
          }
        </script>
      </>
    )}

    <div class="toast" id="toast"></div>

    {session && (
      <script is:inline define:vars={{ site, CATEGORIES }}>
        const rows = document.getElementById("rows");
        const countEl = document.getElementById("count");
        const emptyState = document.getElementById("emptyState");
        const toastEl = document.getElementById("toast");
        const addForm = document.getElementById("addForm");

        const escapeHtml = (s) =>
          String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
        const slugify = (s) =>
          String(s ?? "").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
        const fmtDate = (iso) => {
          try {
            return new Intl.DateTimeFormat("id-ID", {
              day: "numeric", month: "short", year: "numeric",
              hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta",
            }).format(new Date(iso));
          } catch { return ""; }
        };
        const prettyLink = (g) => (g.slug ? `${site}/undangan/${g.slug}` : "");

        let toastTimer;
        // `action` turns the toast into the only way back from a delete, so it
        // stays up long enough to be read and tapped on a phone.
        const toast = (msg, isErr, action) => {
          toastEl.textContent = "";
          toastEl.append(msg);
          toastEl.classList.toggle("err", !!isErr);
          if (action) {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "toast-action";
            b.textContent = action.label;
            b.addEventListener("click", () => {
              toastEl.classList.remove("show");
              action.onClick();
            });
            toastEl.append(b);
          }
          toastEl.classList.add("show");
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => toastEl.classList.remove("show"), action ? 15000 : 2000);
        };
        // The password dialog lives in its own <script> block and needs the same
        // confirmation strip; this is the seam between the two.
        window.kirabToast = (msg, isErr) => {
          toast(msg, isErr);
        };

        // ── view state: search + sort + pagination ──
        // 100 cards is roughly 53,000px of scrolling on a phone; a page you can
        // actually reach the bottom of beats one big list.
        const PAGE_SIZE = window.matchMedia("(max-width: 1024px)").matches ? 25 : 100;
        const pager = document.getElementById("pager");
        let query = "", sortBy = "terbaru", catFilter = "", page = 1;

        const byName = (a, b) => (a.dataset.name || "").localeCompare(b.dataset.name || "", "id", { sensitivity: "base" });
        const byId = (a, b) => Number(a.dataset.id) - Number(b.dataset.id);
        const byCat = (a, b) => (a.querySelector(".cat-select")?.value || "").localeCompare(b.querySelector(".cat-select")?.value || "", "id");

        const sortRows = (arr) => {
          if (sortBy === "terbaru") arr.sort((a, b) => byId(b, a));
          else if (sortBy === "terlama") arr.sort(byId);
          else if (sortBy === "nama-asc") arr.sort(byName);
          else if (sortBy === "nama-desc") arr.sort((a, b) => byName(b, a));
          else if (sortBy === "kategori") arr.sort((a, b) => byCat(a, b) || byName(a, b));
          return arr;
        };

        const renderPager = (total, totalPages) => {
          if (total <= PAGE_SIZE) { pager.hidden = true; pager.innerHTML = ""; return; }
          pager.hidden = false;
          pager.innerHTML =
            `<button class="btn btn-ghost btn-sm" data-page="prev"${page <= 1 ? " disabled" : ""}>‹ Sebelumnya</button>` +
            `<span class="page-label">Hal. ${page} / ${totalPages}</span>` +
            `<button class="btn btn-ghost btn-sm" data-page="next"${page >= totalPages ? " disabled" : ""}>Berikutnya ›</button>`;
        };

        // Search only the real guest data — NOT tr.textContent (which includes the
        // category <select>'s full option list, both URLs, and button labels).
        const haystack = (tr) =>
          `${tr.dataset.salutation} ${tr.dataset.name} ${tr.dataset.address} ${tr.querySelector(".cat-select")?.value ?? ""} ${tr.dataset.slug}`.toLowerCase();

        const applyView = () => {
          const all = Array.from(rows.children);
          const visible = sortRows(all.filter((tr) =>
            haystack(tr).includes(query) &&
            (!catFilter || (tr.querySelector(".cat-select")?.value === catFilter))
          ));
          const hidden = all.filter((tr) => !visible.includes(tr));
          visible.forEach((tr) => rows.appendChild(tr));            // reorder to sorted order
          hidden.forEach((tr) => { tr.style.display = "none"; rows.appendChild(tr); });
          const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
          if (page > totalPages) page = totalPages;
          visible.forEach((tr, i) => {
            tr.style.display = Math.floor(i / PAGE_SIZE) + 1 === page ? "" : "none";
          });
          countEl.textContent = visible.length;
          emptyState.style.display = visible.length ? "none" : "";
          renderPager(visible.length, totalPages);
        };
        const updateCount = applyView; // add/delete call this to re-render the view

        const guestOf = (tr) => ({
          salutation: tr.dataset.salutation, name: tr.dataset.name,
          address: tr.dataset.address, slug: tr.dataset.slug,
        });
        const refreshLink = (tr) => {
          const g = guestOf(tr);
          const prettyRow = tr.querySelector("[data-pretty-row]");
          const pretty = tr.querySelector("[data-link-pretty]");
          if (g.slug) {
            const u = prettyLink(g);
            pretty.href = u; pretty.textContent = u;
            prettyRow.style.display = "";
          } else {
            prettyRow.style.display = "none";
          }
        };

        // Recompute the "X dibuka · Y dikunjungi" summary from the current rows.
        const summaryEl = document.getElementById("summary");
        const refreshSummary = () => {
          let opened = 0, visited = 0;
          rows.querySelectorAll(".stat").forEach((s) => {
            // "visited" excludes the opened ones — same split as the panel above.
            if (s.classList.contains("opened")) opened++;
            else if (s.classList.contains("visited")) visited++;
          });
          if (summaryEl) summaryEl.innerHTML = `<strong>${opened}</strong> dibuka · <strong>${visited}</strong> dikunjungi`;
        };

        const catOptions = (selected) =>
          CATEGORIES.map((c) => `<option value="${escapeHtml(c)}"${c === selected ? " selected" : ""}>${escapeHtml(c)}</option>`).join("");

        const buildRow = (g) => {
          const tr = document.createElement("tr");
          tr.dataset.id = g.id;
          tr.dataset.name = g.name;
          tr.dataset.salutation = g.salutation || "";
          tr.dataset.address = g.address || "";
          tr.dataset.slug = g.slug || "";
          const editCell = (field, val, label, cls) =>
            `<td data-label="${label}"><div class="cell ${cls || ""}" contenteditable="plaintext-only" spellcheck="false" autocapitalize="words" data-field="${field}">${escapeHtml(val)}</div></td>`;
          const pretty = prettyLink(g);
          const visits = g.visit_count ?? 0, opens = g.open_count ?? 0;
          const state = opens > 0 ? "opened" : visits > 0 ? "visited" : "none";
          const stateLabel = state === "opened" ? "Dibuka" : state === "visited" ? "Dikunjungi" : "Belum dibuka";
          tr.innerHTML =
            editCell("salutation", g.salutation, "Sebutan") +
            editCell("name", g.name, "Nama") +
            editCell("address", g.address, "Alamat") +
            `<td data-label="Kategori"><select class="cat-select" data-field="category">${catOptions(g.category)}</select></td>` +
            editCell("slug", g.slug, "Tautan Kustom", "slug") +
            `<td data-label="Tautan"><div class="link-col">` +
              `<div class="link-row" data-pretty-row${pretty ? "" : ' style="display:none"'}><a href="${escapeHtml(pretty)}" target="_blank" rel="noopener" data-link-pretty>${escapeHtml(pretty)}</a><button class="btn btn-ghost btn-sm" data-copy>Salin</button><button class="btn btn-icon btn-wa" data-wa aria-label="Bagikan via WhatsApp" title="Bagikan via WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.29-.15-1.72-.85-1.99-.94-.27-.1-.46-.15-.66.15-.19.29-.75.94-.92 1.13-.17.19-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.44-.87-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.51-.07-.15-.66-1.58-.9-2.16-.24-.57-.48-.49-.66-.5h-.56c-.19 0-.51.07-.77.36-.27.29-1.01.99-1.01 2.41 0 1.42 1.04 2.79 1.18 2.98.15.19 2.04 3.12 4.95 4.38.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.12.56-.09 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.34zM12.04 21.5h-.01a9.4 9.4 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.38 9.38 0 01-1.44-5.02c0-5.2 4.24-9.43 9.45-9.43 2.52 0 4.89.98 6.67 2.77a9.36 9.36 0 012.76 6.67c0 5.2-4.24 9.43-9.44 9.43zm8.04-17.47A11.32 11.32 0 0012.04 1C5.79 1 .7 6.08.7 12.33c0 1.99.52 3.94 1.51 5.66L.6 23.4l5.55-1.46a11.3 11.3 0 005.89 1.62h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.31-8.01z"/></svg></button></div>` +
            `</div></td>` +
            `<td data-label="Dibuka"><div class="stat ${state}" data-stat data-visits="${visits}" data-opens="${opens}"><span class="dot"></span><span class="lbl">${stateLabel}</span><span class="nums">👁 ${visits} · 📂 ${opens}</span></div></td>` +
            `<td data-label="Ditambah" class="date-cell">${escapeHtml(fmtDate(g.created_at))}</td>` +
            `<td data-label="Diaudit oleh" class="date-cell" data-audit>${escapeHtml(g.audited_by || "—")}</td>` +
            `<td data-label="Aksi"><div class="row-actions"><button class="btn btn-ghost btn-icon btn-danger" data-del aria-label="Hapus tamu" title="Hapus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button></div></td>`;
          return tr;
        };

        // ── add guest ── auto-fill slug from name unless edited
        const slugInput = addForm.slug, nameInput = addForm.name;
        let slugTouched = false;
        slugInput.addEventListener("input", () => { slugTouched = slugInput.value.trim() !== ""; });
        nameInput.addEventListener("input", () => { if (!slugTouched) slugInput.value = slugify(nameInput.value); });

        addForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const data = Object.fromEntries(new FormData(addForm));
          if (!data.name?.trim() || !data.address?.trim() || !data.category) {
            return toast("Nama, alamat, dan kategori wajib diisi.", true);
          }
          const btn = addForm.querySelector("button");
          btn.disabled = true;
          try {
            const res = await fetch("/api/users", {
              method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(data),
            });
            const out = await res.json();
            if (!res.ok) throw new Error(out.error || "gagal");
            rows.prepend(buildRow(out.guest));
            addForm.reset();
          addForm.querySelector('[name="name"]')?.focus();
            slugTouched = false;
            updateCount();
            refreshSummary();
            toast("Tamu ditambahkan");
          } catch (err) {
            toast("Gagal: " + err.message, true);
          } finally {
            btn.disabled = false;
          }
        });

        // Enter must not open a second line: textContent joins block children
        // with no separator, so the saved value silently glues them together.
        // Escape restores the value the cell had on focus.
        rows.addEventListener("keydown", (e) => {
          const cell = e.target.closest?.("[contenteditable]");
          if (!cell) return;
          if (e.key === "Enter") { e.preventDefault(); cell.blur(); }
          else if (e.key === "Escape") {
            e.preventDefault();
            cell.textContent = cell.dataset.baseline ?? "";
            cell.blur();
          }
        });

        // ── inline text edit (delegated): baseline on focus, save on blur if changed
        rows.addEventListener("focusin", (e) => {
          const cell = e.target.closest(".cell[contenteditable]");
          if (cell) cell.dataset.baseline = cell.textContent.trim();
        });
        rows.addEventListener("focusout", async (e) => {
          const cell = e.target.closest(".cell[contenteditable]");
          if (!cell) return;
          const tr = cell.closest("tr");
          const field = cell.dataset.field;
          let value = cell.textContent.trim();
          const baseline = cell.dataset.baseline ?? "";
          if (value === baseline) return;

          if (field === "slug") value = value.toLowerCase().replace(/[^a-z0-9-]+/g, ""); // keep dashes (match API)
          if ((field === "name" || field === "address") && !value) {
            toast(field + " tidak boleh kosong", true);
            cell.textContent = baseline;
            return;
          }
          if (field === "slug" && value) cell.textContent = value; // reflect normalization
          await save(tr, cell, field, value, baseline);
        });

        // ── category select (delegated)
        rows.addEventListener("change", async (e) => {
          const sel = e.target.closest(".cat-select");
          if (!sel) return;
          const tr = sel.closest("tr");
          await save(tr, sel, "category", sel.value, null);
        });

        async function save(tr, el, field, value, baseline) {
          tr.classList.add("saving");
          try {
            const res = await fetch(`/api/users/${tr.dataset.id}`, {
              method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ [field]: value }),
            });
            const out = await res.json();
            if (!res.ok) throw new Error(out.error || "gagal");
            const g = out.guest;
            tr.dataset.name = g.name;
            tr.dataset.salutation = g.salutation || "";
            tr.dataset.address = g.address || "";
            tr.dataset.slug = g.slug || "";
            if (el.dataset) el.dataset.baseline = value;
            refreshLink(tr);
            const auditCell = tr.querySelector("[data-audit]");
            if (auditCell && g.audited_by) auditCell.textContent = g.audited_by;
            toast("Tersimpan");
            // A toast alone is not enough on a phone: it fires behind the
            // keyboard. Mark the row so the confirmation sits under the name.
            // Success path only — this used to sit in the finally, so a save
            // that failed and reverted the text still showed "✓ Tersimpan",
            // and this marker is the one the volunteer actually reads.
            tr.dataset.saved = "1";
            window.clearTimeout(tr._savedT);
            tr._savedT = window.setTimeout(() => delete tr.dataset.saved, 4000);
          } catch (err) {
            toast("Gagal: " + err.message, true);
            if (baseline !== null && el.textContent !== undefined) el.textContent = baseline; // revert text cell
          } finally {
            tr.classList.remove("saving");
          }
        }

        // ── copy / delete (delegated)
        rows.addEventListener("click", async (e) => {
          const tr = e.target.closest("tr");
          if (!tr) return;
          if (e.target.closest("[data-copy]")) {
            const url = e.target.closest(".link-row").querySelector("a").href;
            try { await navigator.clipboard.writeText(url); toast("Tautan disalin"); }
            catch { toast("Tidak bisa menyalin", true); }
          }
          if (e.target.closest("[data-wa]")) {
            // Share via WhatsApp: open with a personalized invitation message +
            // the guest's link prefilled. wa.me/?text lets the sender pick who to
            // send it to (no phone number stored per guest).
            const url = e.target.closest(".link-row").querySelector("a").href;
            const greet = [tr.dataset.salutation, tr.dataset.name].map((s) => (s || "").trim()).filter(Boolean).join(" ") || "Bapak/Ibu";
            const msg =
              `Yth. ${greet} 🙏\n\n` +
              `Dengan penuh sukacita, kami mengundang Anda ke *Kirab Budaya & Ruwat Bumi 2026* — Tjie Thien Ta Sen Bio, Tangerang.\n\n` +
              `Silakan buka undangan digital Anda di:\n${url}\n\n` +
              `Suatu kehormatan atas kehadiran Anda. Terima kasih. 🏮`;
            window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
          }
          if (e.target.closest("[data-del]")) {
            if (!confirm(`Hapus tamu "${tr.dataset.name}"?`)) return;
            // The slug dies with the row, so a link already sent over WhatsApp
            // starts 404-ing. Keep enough to put the guest back exactly.
            const snapshot = {
              name: tr.dataset.name,
              salutation: tr.dataset.salutation || null,
              address: tr.dataset.address || null,
              slug: tr.dataset.slug || null,
              category: tr.querySelector('[data-field="category"]')?.value,
            };
            tr.classList.add("saving");
            try {
              const res = await fetch(`/api/users/${tr.dataset.id}`, { method: "DELETE" });
              if (!res.ok) throw new Error("gagal");
              tr.remove();
              updateCount();
              refreshSummary();
              toast("Tamu dihapus", false, {
                label: "Urungkan",
                onClick: async () => {
                  // Unguarded, an offline tap rejected here with nothing shown:
                  // the toast carrying this button had already been dismissed,
                  // so the guest stayed deleted and the volunteer believed the
                  // undo had worked. Never leave this one silent.
                  try {
                    const r = await fetch("/api/users", {
                      method: "POST",
                      headers: { "Content-Type": "application/json" },
                      body: JSON.stringify(snapshot),
                    });
                    if (r.ok) return location.reload();
                    toast("Gagal mengurungkan — tamu perlu ditambah ulang", true);
                  } catch {
                    toast("Gagal mengurungkan — periksa koneksi, tamu perlu ditambah ulang", true);
                  }
                },
              });
            } catch { tr.classList.remove("saving"); toast("Gagal menghapus", true); }
          }
        });

        // ── search / sort / pager wiring
        document.getElementById("search").addEventListener("input", (e) => {
          query = e.target.value.toLowerCase().trim(); page = 1; applyView();
        });
        document.getElementById("sortBy").addEventListener("change", (e) => {
          sortBy = e.target.value; page = 1; applyView();
        });
        document.getElementById("catFilter").addEventListener("change", (e) => {
          catFilter = e.target.value; page = 1; applyView();
        });
        pager.addEventListener("click", (e) => {
          const btn = e.target.closest("[data-page]");
          if (!btn) return;
          page += btn.dataset.page === "next" ? 1 : -1;
          applyView();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        // Initial sort + paginate, THEN reveal the list (removes the placeholder)
        // so the first thing the user sees is already correctly ordered.
        const wrapEl = document.querySelector(".wrap");
        try { applyView(); } finally { wrapEl?.classList.remove("loading"); }
        // Failsafe: never leave the list hidden if the initial render threw early.
        setTimeout(() => wrapEl?.classList.remove("loading"), 3000);

        // ── CSV export
        document.getElementById("csvBtn").addEventListener("click", () => {
          const esc = (v) => `"${String(v || "").replace(/"/g, '""')}"`;
          const lines = [["Sebutan", "Nama", "Alamat", "Kategori", "Tautan Kustom", "Tautan Undangan", "Status", "Kunjungan", "Dibuka"].join(",")];
          rows.querySelectorAll("tr").forEach((tr) => {
            const c = (f) => (tr.querySelector(`[data-field="${f}"]`)?.value ?? tr.querySelector(`[data-field="${f}"]`)?.textContent ?? "").trim();
            const pretty = tr.querySelector("[data-link-pretty]")?.getAttribute("href") || "";
            const stat = tr.querySelector("[data-stat]");
            const status = stat?.querySelector(".lbl")?.textContent?.trim() || "";
            const visits = stat?.getAttribute("data-visits") || "0";
            const opens = stat?.getAttribute("data-opens") || "0";
            lines.push([esc(c("salutation")), esc(c("name")), esc(c("address")), esc(c("category")), esc(c("slug")), esc(pretty), esc(status), esc(visits), esc(opens)].join(","));
          });
          const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = "tamu-undangan-kirab.csv";
          a.click();
          URL.revokeObjectURL(a.href);
        });
      </script>
    )}
  </body>
</html>
